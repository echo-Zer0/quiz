# ==============================================================================
# Global Gitignore - Security & Clean Repository
# ==============================================================================

# Secrets & Environment Variables
.env
.env.*
*.env
!.env.example
*.local
*.secret
*.pem
*.key

# Python Virtual Environments & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# Node.js & Next.js Builds
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
.turbo/

# Databases & SQLite
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
quiz_local.sqlite
backend/quiz_local.sqlite

# Logs & Runtime Diagnostics
*.log
logs/
*.pid
*.seed
*.pid.lock
.temp/
tmp/
temp/

# OS & IDE Settings
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
